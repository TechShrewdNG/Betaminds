# Canonical origin, used for metadata, sitemap.xml and robots.txt.
SITE_URL="https://betaminds.africa"

# Postgres connection string. Required — see README.md for why SQLite doesn't
# work on Vercel. Easiest source: Vercel dashboard → project → Storage →
# Create Database → Postgres (Neon), which injects this for you; for local
# development, a free Neon/Supabase project or a local Docker Postgres both
# work fine.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Signs the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-32-byte-random-hex-string"

# Seeded on `npm run db:seed`. Change the password after first login.
ADMIN_EMAIL="hello@betaminds.africa"
ADMIN_PASSWORD="betaminds-admin"
ADMIN_NAME="Betaminds Admin"

# Where uploaded images are written. Relative paths resolve from the project
# root. Deliberately outside `public/` — see src/lib/storage.ts. Point this at
# a persistent volume in production.
UPLOAD_DIR=".data/uploads"

# --- Email ------------------------------------------------------------------
# Who gets told when a submission arrives. Comma-separated.
NOTIFY_EMAILS="hello@betaminds.africa"

# The From address on outbound mail.
EMAIL_FROM="Betaminds Africa <hello@betaminds.africa>"

# Transport: "resend", "smtp" or "none". Inferred from the credentials below
# when unset, so setting a key is enough. With nothing set, submissions are
# still stored and the intended email is logged instead.
# EMAIL_TRANSPORT="resend"

# Option 1 — Resend (https://resend.com). No extra dependency, called over REST.
# RESEND_API_KEY=""

# Option 2 — any SMTP server, including Google Workspace.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# Send a confirmation to whoever submitted. Off by default: this needs a
# verified sending domain, or the confirmations land in spam and hurt
# deliverability. Turn on once the domain is set up.
# EMAIL_AUTOREPLY="true"
